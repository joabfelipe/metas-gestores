<section class="mx-auto max-w-2xl space-y-6">
  <div class="card">
    <div class="card-header">
      <div>
        <h2 class="text-xl font-semibold">Link para preenchimento</h2>
        <p class="text-sm text-muted">Compartilhe o acesso com o gestor responsável.</p>
      </div>
      <%- include("../partials/components/button", { href: "/admin/managers", label: "Voltar", variant: "btn-secondary", size: "btn-xs" }) %>
    </div>
    <div class="card-body space-y-4">
      <div class="grid gap-3 rounded-xl border border-border bg-muted/30 p-4 text-sm">
        <div>
          <div class="text-muted">Gestor</div>
          <div class="font-semibold"><%= manager.name %> <span class="text-muted">(<%= manager.department %>)</span></div>
        </div>
        <div>
          <div class="text-muted">Período</div>
          <div class="font-semibold"><%= month %>/<%= year %></div>
        </div>
      </div>
      
      <form id="linkForm" method="get" class="field">
          <input type="hidden" name="period" value="<%= year %>-<%= String(month).padStart(2, '0') %>">
          <label class="field-label">Selecione a Unidade (opcional)</label>
          <select name="businessUnit" class="select" onchange="document.getElementById('linkForm').submit()">
              <option value="">Todas as Unidades</option>
              <% if (manager.units && manager.units.length > 0) { %>
                  <% manager.units.forEach(u => { %>
                      <option value="<%= u %>" <%= businessUnit === u ? 'selected' : '' %>><%= u %></option>
                  <% }) %>
              <% } %>
          </select>
          <p class="field-hint">Selecione uma unidade para gerar um link específico para ela.</p>
      </form>

      <div class="field">
        <label class="field-label">Credenciais de Acesso</label>
        <div class="grid gap-4 sm:grid-cols-2">
            <div class="p-3 bg-gray-50 rounded border border-gray-200">
                <div class="text-xs text-gray-500 uppercase font-semibold">Login</div>
                <div class="font-mono text-lg select-all"><%= manager.email %></div>
            </div>
            <div class="p-3 bg-gray-50 rounded border border-gray-200">
                <div class="text-xs text-gray-500 uppercase font-semibold">Senha</div>
                <% if (typeof newPassword !== 'undefined' && newPassword) { %>
                    <div class="font-mono text-lg text-green-600 font-bold select-all"><%= newPassword %></div>
                    <div class="text-xs text-green-600 mt-1">Senha gerada agora! Copie antes de sair.</div>
                <% } else if (manager.password) { %>
                    <div class="font-mono text-lg text-gray-400">********</div>
                    <div class="text-xs text-gray-500 mt-1">Senha já definida pelo usuário.</div>
                <% } else { %>
                    <div class="font-mono text-lg text-red-500">Não definida</div>
                    <div class="text-xs text-red-500 mt-1">Gere uma senha abaixo.</div>
                <% } %>
            </div>
        </div>
        
        <div class="mt-2">
            <form action="/admin/managers/<%= manager._id %>/generate-credentials" method="post" onsubmit="return confirm('Isso irá resetar a senha do gestor. Deseja continuar?');">
                <button type="submit" class="btn btn-warning btn-sm w-full sm:w-auto">
                    <%= manager.password ? 'Resetar Senha' : 'Gerar Senha Inicial' %>
                </button>
            </form>
        </div>
      </div>

      <%
      const monthNames = ["Janeiro", "Fevereiro", "Março", "Abril", "Maio", "Junho", "Julho", "Agosto", "Setembro", "Outubro", "Novembro", "Dezembro"];
      const currentMonthName = monthNames[month - 1];
      const unitText = businessUnit ? businessUnit : "Todas as Unidades";
      
      // Constrói URL de login baseada no host atual (aproximado, já que link vem com /g/token)
      // Vamos extrair a base do link gerado anteriormente
      const baseUrl = link.split('/g/')[0];
      const loginUrl = `${baseUrl}/login`;

      const emailSubject = `Acesso ao Sistema de Metas - ${currentMonthName}/${year}`;
      let emailBody = `Olá ${manager.name},

Segue suas credenciais para acesso ao sistema de metas (${currentMonthName}/${year}).

Acesse: ${loginUrl}

Login: ${manager.email}
Senha: ${typeof newPassword !== 'undefined' && newPassword ? newPassword : (manager.password ? 'Use sua senha atual' : 'Solicite sua senha ao administrador')}

No primeiro acesso, será necessário definir uma nova senha pessoal.

Atenciosamente,
Equipe de Controladoria`;
      %>

      <div class="field pt-4 border-t border-border">
        <label class="field-label">Assunto Sugerido</label>
        <div class="flex gap-2">
            <input id="emailSubject" value="<%= emailSubject %>" readonly class="input" onclick="this.select()" />
            <button onclick="copySubject()" class="btn btn-secondary btn-sm">Copiar</button>
        </div>
      </div>

      <div class="field">
        <label class="field-label">Corpo do E-mail</label>
        <div class="relative">
            <textarea id="emailDraft" class="textarea h-48 font-mono text-sm" readonly><%= emailBody %></textarea>
            <div class="absolute top-2 right-2">
                <button onclick="copyEmail()" class="btn btn-secondary btn-xs">Copiar Corpo</button>
            </div>
        </div>
        <p class="field-hint">Copie este texto e cole no seu cliente de e-mail.</p>
      </div>
    </div>
  </div>
</section>

<script>
function copySubject() {
  const input = document.getElementById("emailSubject");
  input.select();
  document.execCommand("copy");
  alert("Assunto copiado!");
}

function copyEmail() {
  const input = document.getElementById("emailDraft");
  input.select();
  document.execCommand("copy");
  alert("Corpo do e-mail copiado!");
}
</script>
