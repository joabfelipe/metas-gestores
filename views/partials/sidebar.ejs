<aside id="appSidebar" class="sidebar">

  <div class="sidebar-brand">
    <div class="sidebar-logo">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/>
        <polyline points="16 7 22 7 22 13"/>
      </svg>
    </div>
    <div>
      <div class="sidebar-brand-name">Nexus<span>Goals</span></div>
      <div class="sidebar-brand-sub">Painel Admin</div>
    </div>
  </div>

  <nav class="sidebar-nav">
    <a class="sidebar-link <%= currentPath === '/admin/dashboard' ? 'sidebar-link-active' : '' %>" href="/admin/dashboard">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <rect x="3" y="3" width="7" height="7" rx="1"/>
        <rect x="14" y="3" width="7" height="7" rx="1"/>
        <rect x="3" y="14" width="7" height="7" rx="1"/>
        <rect x="14" y="14" width="7" height="7" rx="1"/>
      </svg>
      Dashboard
    </a>
    <a class="sidebar-link <%= currentPath === '/admin/managers' ? 'sidebar-link-active' : '' %>" href="/admin/managers">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
        <circle cx="9" cy="7" r="4"/>
        <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
        <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
      </svg>
      Gestores
    </a>
    <a class="sidebar-link <%= currentPath === '/admin/goals' ? 'sidebar-link-active' : '' %>" href="/admin/goals">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/>
        <polyline points="16 7 22 7 22 13"/>
      </svg>
      Metas
    </a>
  </nav>

  <div style="margin-top:auto; padding-top:16px; border-top:1px solid var(--border);">
    <div style="font-size:10px; color:var(--text-muted); letter-spacing:0.08em; display:flex; align-items:center; gap:6px; padding:4px 4px;">
      <span style="width:5px;height:5px;border-radius:50%;background:var(--accent);box-shadow:0 0 6px var(--accent);flex-shrink:0;animation:pulse 2s ease-in-out infinite;"></span>
      SISTEMA ONLINE
    </div>
  </div>

</aside>
