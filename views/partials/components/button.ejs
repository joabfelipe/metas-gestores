<%
  const _href = (typeof href !== 'undefined' && href) ? href : '';
  const _type = (typeof type !== 'undefined' && type) ? type : 'button';
  const _variant = (typeof variant !== 'undefined' && variant) ? variant : 'primary';
  const _label = (typeof label !== 'undefined' && label) ? label : '';
  const _size = (typeof size !== 'undefined' && size) ? size : '';
  const _disabled = (typeof disabled !== 'undefined' && disabled) ? true : false;
  
  let variantClasses = "bg-primary text-primary-foreground hover:bg-primary/90";
  if (_variant === 'secondary' || _variant === 'btn-secondary') {
    variantClasses = "bg-muted text-foreground hover:bg-muted/80";
  } else if (_variant === 'danger' || _variant === 'destructive') {
    variantClasses = "bg-danger text-white hover:bg-danger/90";
  } else if (_variant === 'success') {
    variantClasses = "bg-success text-white hover:bg-success/90";
  } else if (_variant === 'warning') {
    variantClasses = "bg-warning text-white hover:bg-warning/90";
  } else if (_variant === 'outline') {
    variantClasses = "border border-border bg-transparent hover:bg-muted/50 text-foreground";
  } else if (_variant === 'ghost') {
    variantClasses = "hover:bg-muted/50 text-foreground";
  }
%>
<% if (_href) { %>
  <a href="<%= _href %>" class="inline-flex items-center justify-center rounded-lg px-4 py-2 text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 disabled:opacity-50 disabled:pointer-events-none ring-offset-background <%= variantClasses %> <%= _size %>"><%= _label %></a>
<% } else { %>
  <button type="<%= _type %>" class="inline-flex items-center justify-center rounded-lg px-4 py-2 text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 disabled:opacity-50 disabled:pointer-events-none ring-offset-background <%= variantClasses %> <%= _size %>" <%= _disabled ? 'disabled' : '' %>><%= _label %></button>
<% } %>
