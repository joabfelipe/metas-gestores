<%
  const _variant = (typeof variant !== 'undefined' && variant) ? variant : '';
  const _icon = (typeof icon !== 'undefined' && icon) ? icon : '!';
  const _title = (typeof title !== 'undefined' && title) ? title : '';
  const _message = (typeof message !== 'undefined' && message) ? message : '';
  
  let variantClasses = "bg-background text-foreground border border-border";
  if (_variant === 'danger') variantClasses = "border-destructive/50 text-destructive dark:border-destructive [&>svg]:text-destructive";
  // Add more variants as needed
%>
<div class="relative w-full rounded-lg border p-4 [&>svg~*]:pl-7 [&>svg+div]:translate-y-[-3px] [&>svg]:absolute [&>svg]:left-4 [&>svg]:top-4 [&>svg]:text-foreground <%= variantClasses %>">
  <div class="mb-1 font-medium leading-none tracking-tight"><%= _title %></div>
  <div class="text-sm [&_p]:leading-relaxed"><%= _message %></div>
</div>
