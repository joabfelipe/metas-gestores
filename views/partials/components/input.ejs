<%
  const _wrapperClass = (typeof wrapperClass !== 'undefined' && wrapperClass) ? wrapperClass : '';
  const _label = (typeof label !== 'undefined' && label) ? label : '';
  const _name = (typeof name !== 'undefined' && name) ? name : '';
  const _id = (typeof id !== 'undefined' && id) ? id : _name;
  const _type = (typeof type !== 'undefined' && type) ? type : 'text';
  const _value = (typeof value !== 'undefined' && value) ? value : '';
  const _placeholder = (typeof placeholder !== 'undefined' && placeholder) ? placeholder : '';
  const _inputClass = (typeof inputClass !== 'undefined' && inputClass) ? inputClass : '';
  const _required = (typeof required !== 'undefined' && required) ? true : false;
  const _readonly = (typeof readonly !== 'undefined' && readonly) ? true : false;
  const _hint = (typeof hint !== 'undefined' && hint) ? hint : '';
%>
<div class="<%= _wrapperClass %>">
  <% if (_label) { %>
    <label class="block text-sm font-medium mb-1 text-foreground" for="<%= _id %>"><%= _label %></label>
  <% } %>
  <input 
    id="<%= _id %>" 
    name="<%= _name %>" 
    type="<%= _type %>" 
    value="<%= _value %>" 
    placeholder="<%= _placeholder %>" 
    class="w-full rounded-lg border border-border bg-surface px-3 py-2 text-sm text-foreground placeholder-muted focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent disabled:cursor-not-allowed disabled:opacity-50 transition-colors <%= _inputClass %>" 
    <%= _required ? 'required' : '' %> 
    <%= _readonly ? 'readonly' : '' %> 
  />
  <% if (_hint) { %>
    <p class="text-xs text-muted mt-1"><%= _hint %></p>
  <% } %>
</div>
