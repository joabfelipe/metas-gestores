<header class="topbar">

  <% if (showSidebar) { %>
    <button id="sidebarToggle" type="button" class="btn btn-secondary btn-xs" style="display:none;" aria-label="Menu">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="3" y1="6" x2="21" y2="6"/>
        <line x1="3" y1="12" x2="21" y2="12"/>
        <line x1="3" y1="18" x2="21" y2="18"/>
      </svg>
    </button>
    <style>
      @media (max-width:1024px) { #sidebarToggle { display:inline-flex !important; } }
    </style>
  <% } %>

  <div>
    <% if (breadcrumbs && breadcrumbs.length) { %>
      <nav class="topbar-breadcrumb">
        <% breadcrumbs.forEach((crumb, i) => { %>
          <% if (crumb.href) { %>
            <a href="<%= crumb.href %>"><%= crumb.label %></a>
          <% } else { %>
            <span class="current"><%= crumb.label %></span>
          <% } %>
          <% if (i < breadcrumbs.length - 1) { %>
            <span class="sep">/</span>
          <% } %>
        <% }) %>
      </nav>
    <% } %>
    <div class="topbar-title"><%= pageTitle %></div>
  </div>

  <div class="topbar-right">
    <% if (topbarActions) { %>
      <%- topbarActions %>
    <% } %>

    <% if (typeof user !== 'undefined' && user) { %>
      <span class="topbar-user" style="display:none;" id="topbar-username"><%= user.name %></span>
      <style>@media(min-width:640px){#topbar-username{display:inline;}}</style>
      <a href="/logout" class="btn btn-secondary btn-xs" style="color:var(--danger);border-color:var(--danger);">Sair</a>
    <% } %>

    <div class="topbar-meta"><%= topbarMeta || 'Admin' %></div>
  </div>

</header>
