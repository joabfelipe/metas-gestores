<!DOCTYPE html>
<%
  const _pageTitle    = (typeof pageTitle    !== 'undefined' && pageTitle)    ? pageTitle    : 'Nexus Goals';
  const _breadcrumbs  = (typeof breadcrumbs  !== 'undefined' && breadcrumbs)  ? breadcrumbs  : [];
  const _topbarActions= (typeof topbarActions!== 'undefined' && topbarActions)? topbarActions: '';
  const _showSidebar  = (typeof showSidebar  !== 'undefined')                 ? showSidebar  : false;
  const _currentPath  = (typeof currentPath  !== 'undefined' && currentPath)  ? currentPath  : '';
  const _topbarMeta   = (typeof topbarMeta   !== 'undefined' && topbarMeta)   ? topbarMeta   : '';
%>
<html lang="pt-BR">
  <%- include("../partials/head", { title: _pageTitle }) %>
  <body>
    <div class="app-shell">

      <% if (_showSidebar) { %>
        <%- include("../partials/sidebar", { currentPath: _currentPath }) %>
      <% } %>

      <div class="app-main">
        <%- include("../partials/topbar", {
          pageTitle:     _pageTitle,
          breadcrumbs:   _breadcrumbs,
          topbarActions: _topbarActions,
          showSidebar:   _showSidebar,
          topbarMeta:    _topbarMeta
        }) %>

        <main class="app-content">
          <% if (success_msg && success_msg.length > 0) { %>
            <div class="alert alert-success" style="margin-bottom:20px;">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
              <%= success_msg %>
            </div>
          <% } %>
          <% if (error_msg && error_msg.length > 0) { %>
            <div class="alert alert-error" style="margin-bottom:20px;">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
              <%= error_msg %>
            </div>
          <% } %>

          <%- body %>
        </main>

        <%- include("../partials/footer") %>
      </div>

    </div>

    <% if (_showSidebar) { %>
      <div id="sidebarOverlay" class="hidden" style="position:fixed;inset:0;z-index:35;background:rgba(0,0,0,0.6);backdrop-filter:blur(2px);"></div>
    <% } %>

    <script>
      const sidebar        = document.getElementById('appSidebar');
      const sidebarToggle  = document.getElementById('sidebarToggle');
      const sidebarOverlay = document.getElementById('sidebarOverlay');

      if (sidebarToggle && sidebar && sidebarOverlay) {
        const open  = () => { sidebar.classList.add('open');    sidebarOverlay.classList.remove('hidden'); };
        const close = () => { sidebar.classList.remove('open'); sidebarOverlay.classList.add('hidden'); };
        sidebarToggle.addEventListener('click', open);
        sidebarOverlay.addEventListener('click', close);
      }

      const monthNames = [
        "Jan",
        "Fev",
        "Mar",
        "Abr",
        "Mai",
        "Jun",
        "Jul",
        "Ago",
        "Set",
        "Out",
        "Nov",
        "Dez",
      ];

      const toPeriodValue = (year, month) => {
        const mm = String(month).padStart(2, "0");
        return `${year}-${mm}`;
      };

      const parsePeriodValue = (value) => {
        const match = /^\s*(\d{4})-(\d{2})\s*$/.exec(String(value || ""));
        if (!match) return null;
        const y = Number(match[1]);
        const m = Number(match[2]);
        if (!Number.isFinite(y) || !Number.isFinite(m) || m < 1 || m > 12) return null;
        return { year: y, month: m };
      };

      const buildMonthFallback = (input) => {
        const form = input.form;
        const now = new Date();
        const current = {
          year: now.getFullYear(),
          month: now.getMonth() + 1,
        };

        const parsed = parsePeriodValue(input.value) || current;

        const wrapper = document.createElement("span");
        wrapper.className = "inline-flex items-center gap-2";

        const monthSelect = document.createElement("select");
        monthSelect.className = input.className;

        const yearSelect = document.createElement("select");
        yearSelect.className = input.className;

        const hidden = document.createElement("input");
        hidden.type = "hidden";
        hidden.name = input.getAttribute("name") || "period";
        hidden.value = toPeriodValue(parsed.year, parsed.month);
        if (input.hasAttribute("required")) hidden.required = true;
        if (input.disabled) {
          hidden.disabled = true;
          monthSelect.disabled = true;
          yearSelect.disabled = true;
        }

        for (let m = 1; m <= 12; m++) {
          const opt = document.createElement("option");
          opt.value = String(m);
          opt.textContent = monthNames[m - 1];
          if (m === parsed.month) opt.selected = true;
          monthSelect.appendChild(opt);
        }

        const startYear = current.year - 5;
        const endYear = current.year + 2;
        for (let y = startYear; y <= endYear; y++) {
          const opt = document.createElement("option");
          opt.value = String(y);
          opt.textContent = String(y);
          if (y === parsed.year) opt.selected = true;
          yearSelect.appendChild(opt);
        }

        const apply = () => {
          const y = Number(yearSelect.value);
          const m = Number(monthSelect.value);
          hidden.value = toPeriodValue(y, m);
        };

        const autoSubmit = input.getAttribute("data-auto-submit") === "true" ||
          String(input.getAttribute("onchange") || "").includes("submit");

        const onChange = () => {
          apply();
          if (autoSubmit && form) form.submit();
        };

        monthSelect.addEventListener("change", onChange);
        yearSelect.addEventListener("change", onChange);

        wrapper.appendChild(hidden);
        wrapper.appendChild(monthSelect);
        wrapper.appendChild(yearSelect);

        input.replaceWith(wrapper);
      };

      document.querySelectorAll("[data-picker='month']").forEach((el) => {
        buildMonthFallback(el);
      });
    </script>
  </body>
</html>
