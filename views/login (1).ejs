<form action="/login" method="POST" class="space-y-0">


  <div class="field">
    <label for="email">Endereço de e-mail</label>
    <div class="field-wrap">
      <svg class="field-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <rect x="2" y="4" width="20" height="16" rx="2"/>
        <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
      </svg>
      <input type="email" id="email" name="email" placeholder="seu@email.com" required autocomplete="email">
    </div>
  </div>

  <div class="field">
    <label for="password">Senha de acesso</label>
    <div class="field-wrap">
      <svg class="field-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
        <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
      </svg>
      <input type="password" id="password" name="password" placeholder="••••••••" required autocomplete="current-password">
    </div>
  </div>

  <button type="submit" class="btn-submit">
    Autenticar &rarr;
  </button>

</form>
