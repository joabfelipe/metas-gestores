<section class="space-y-6">
  <div class="card">
    <div class="card-header">
      <div>
        <h2 class="text-xl font-semibold">
          Preenchimento de metas 
          <% if (locals.businessUnit) { %>
            - <%= businessUnit %>
          <% } else if (manager.units && manager.units.length > 0) { %>
            - <%= manager.units.join(", ") %>
          <% } %>
        </h2>
        <p class="text-sm text-muted">Complete os resultados do período informado.</p>
      </div>
      <div class="flex gap-2 items-center">
        <% if (locals.hasMultipleUnits) { %>
          <a href="/manager/dashboard?changeUnit=true" class="btn btn-outline btn-sm text-xs h-7">
            Trocar Unidade
          </a>
        <% } %>
        <% if (locals.businessUnit) { %>
          <div class="rounded-full border border-primary/20 bg-primary/10 px-3 py-1 text-xs text-primary font-medium">
            <%= businessUnit %>
          </div>
        <% } %>
        <form action="<%= locals.formAction.split('?')[0] %>" method="GET" class="flex items-center m-0 p-0">
          <% if (locals.businessUnit) { %>
            <input type="hidden" name="businessUnit" value="<%= businessUnit %>">
          <% } %>
          <input 
            type="month" 
            name="period" 
            value="<%= year %>-<%= String(month).padStart(2, '0') %>" 
            class="rounded-full border border-border bg-transparent px-3 py-1 text-xs text-muted focus:border-primary focus:ring-0 cursor-pointer w-auto h-auto leading-none"
            onchange="this.form.submit()"
            title="Selecione o mês"
          />
        </form>
      </div>
    </div>
    <div class="card-body">
      <div class="flex flex-wrap items-center gap-2 text-sm text-muted">
        <span class="font-semibold text-foreground"><%= manager.name %></span>
        <span>•</span>
        <span><%= manager.departments && manager.departments.length ? manager.departments.join(', ') : manager.department %></span>
      </div>
    </div>
  </div>

  <% if (goals.length === 0) { %>
    <div class="empty-state">
      <div class="text-4xl">📝</div>
      <div class="text-sm font-semibold">Nenhuma meta cadastrada</div>
      <div class="text-sm text-muted">Fale com a administração para liberar o período.</div>
    </div>
  <% } else { %>
    <div class="card">
      <div class="card-header">
        <div>
          <h3 class="card-title">Metas do período</h3>
          <p class="text-sm text-muted">Informe o atingido e o plano de ação quando necessário.</p>
        </div>
      </div>
      <div class="card-body">
        <form method="post" action="<%= locals.formAction %>" class="space-y-6">
          <div class="table-wrap">
            <table class="table table-card">
              <thead>
                <tr>
                  <th>Meta</th>
                  <th>Alvo</th>
                  <th>Atingido</th>
                  <th>Plano de ação</th>
                  <% if (isEditable) { %>
                  <th class="w-[80px] text-center">Salvar</th>
                  <% } %>
                </tr>
              </thead>
              <tbody>
                <% 
                  let currentDepartment = null;
                %>
                <% goals.forEach((g) => { %>
                  <% if (currentDepartment !== g.department) { %>
                    <% currentDepartment = g.department; %>
                    <tr class="bg-muted/5 border-t border-b">
                      <td colspan="<%= isEditable ? 5 : 4 %>" class="py-3 px-4 font-bold text-base text-primary uppercase tracking-wide">
                        <%= currentDepartment || 'Geral' %>
                      </td>
                    </tr>
                  <% } %>
                  <tr>
                    <td data-label="Meta">
                      <div class="font-semibold text-foreground"><%= g.title %></div>
                      <input type="hidden" name="goalId[]" value="<%= g._id %>"/>
                    </td>
                    <td data-label="Alvo"><%= g.targetValue %> <%= g.unit %></td>
                    <td data-label="Atingido">
                      <input type="number" step="0.01" name="achievedValue[]" value="<%= g.achievedValue ?? "" %>" placeholder="Valor" class="input w-full min-w-[100px]" <%= !isEditable ? 'disabled' : '' %> />
                    </td>
                    <td data-label="Plano de ação">
                      <textarea name="actionPlan[]" rows="2" placeholder="Descreva o plano de ação..." class="textarea min-w-[200px]" <%= !isEditable ? 'disabled' : '' %>><%= g.actionPlan || "" %></textarea>
                    </td>
                    <% if (isEditable) { %>
                    <td data-label="Salvar" class="text-center align-middle">
                      <button type="button" class="btn btn-ghost btn-sm btn-save-row text-primary hover:bg-primary/10" title="Salvar individualmente">
                        💾
                      </button>
                    </td>
                    <% } %>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>

          <% if (isEditable) { %>
          <div class="flex justify-end gap-3">
            <%- include("../partials/components/button", { type: "submit", label: "Salvar Tudo", variant: "btn-primary" }) %>
          </div>
          <% } %>
        </form>
      </div>
    </div>
  <% } %>
</section>

<script>
document.addEventListener('DOMContentLoaded', () => {
    const buttons = document.querySelectorAll('.btn-save-row');
    
    buttons.forEach(btn => {
        btn.addEventListener('click', async (e) => {
            e.preventDefault();
            const row = btn.closest('tr');
            const goalId = row.querySelector('input[name="goalId[]"]').value;
            const achievedValue = row.querySelector('input[name="achievedValue[]"]').value;
            const actionPlan = row.querySelector('textarea[name="actionPlan[]"]').value;
            
            // Determina a URL de salvamento baseada na action do formulário
            let saveUrl = "/manager/save-goal";
            const formAction = "<%= locals.formAction %>";
            
            if (formAction.includes("/g/")) {
                 // Formato esperado: /g/TOKEN?params
                 const parts = formAction.split('/');
                 // parts[0] = "", parts[1] = "g", parts[2] = "TOKEN?params"
                 if (parts.length > 2) {
                     const token = parts[2].split('?')[0];
                     saveUrl = `/g/${token}/save-goal`;
                 }
            }

            try {
                const originalContent = btn.innerHTML;
                btn.disabled = true;
                btn.innerHTML = '⏳';
                
                const response = await fetch(saveUrl, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        goalId,
                        achievedValue,
                        actionPlan
                    })
                });
                
                if (response.ok) {
                    btn.innerHTML = '✅';
                    setTimeout(() => { 
                        btn.innerHTML = originalContent; 
                        btn.disabled = false; 
                    }, 2000);
                } else {
                    const data = await response.json();
                    alert('Erro ao salvar: ' + (data.error || 'Erro desconhecido'));
                    btn.innerHTML = '❌';
                    setTimeout(() => { 
                        btn.innerHTML = originalContent; 
                        btn.disabled = false; 
                    }, 2000);
                }
            } catch (error) {
                console.error(error);
                alert('Erro de conexão ao salvar.');
                btn.innerHTML = '❌';
                setTimeout(() => { 
                    btn.innerHTML = originalContent; 
                    btn.disabled = false; 
                }, 2000);
            }
        });
    });
});
</script>
