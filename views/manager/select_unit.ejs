<section class="space-y-6">
  <div class="card">
    <div class="card-header">
      <div>
        <h2 class="text-xl font-semibold">Seleção de Unidade</h2>
        <p class="text-sm text-muted">Existem metas a serem preenchidas em múltiplas unidades.</p>
      </div>
      <form action="/manager/dashboard" method="GET" class="flex items-center m-0 p-0">
        <input type="hidden" name="changeUnit" value="true">
        <input 
          type="month" 
          name="period" 
          value="<%= year %>-<%= String(month).padStart(2, '0') %>" 
          class="rounded-full border border-border bg-transparent px-3 py-1 text-xs text-muted focus:border-primary focus:ring-0 cursor-pointer w-auto h-auto leading-none"
          data-picker="month"
          data-auto-submit="true"
          onchange="this.form.submit()"
          title="Selecione o mês"
        />
      </form>
    </div>
    <div class="card-body">
      <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        <% unitsStatus.forEach(unit => { %>
          <div class="card border transition-colors hover:border-primary/50">
            <div class="card-body space-y-4">
              <div class="flex items-center justify-between">
                <h3 class="font-semibold text-foreground"><%= unit.name %></h3>
                <% if (unit.pending === 0) { %>
                  <span class="inline-flex items-center rounded-full bg-success/10 px-2 py-1 text-xs font-medium text-success ring-1 ring-inset ring-success/20">Concluído</span>
                <% } else { %>
                  <span class="inline-flex items-center rounded-full bg-warning/10 px-2 py-1 text-xs font-medium text-warning ring-1 ring-inset ring-warning/20"><%= unit.pending %> Pendentes</span>
                <% } %>
              </div>
              
              <div class="space-y-2">
                <div class="flex justify-between text-xs text-muted">
                  <span>Progresso</span>
                  <span><%= unit.filled %>/<%= unit.total %></span>
                </div>
                <div class="h-2 w-full overflow-hidden rounded-full bg-muted/20">
                  <div class="h-full bg-primary transition-all" style="width: <%= unit.total > 0 ? (unit.filled / unit.total) * 100 : 0 %>%"></div>
                </div>
              </div>

              <form action="/manager/select-unit" method="POST" class="w-full">
                <input type="hidden" name="businessUnit" value="<%= unit.name %>">
                <input type="hidden" name="year" value="<%= year %>">
                <input type="hidden" name="month" value="<%= month %>">
                <button type="submit" class="btn btn-outline w-full justify-center">
                  <% if (unit.pending === 0) { %>
                    Visualizar
                  <% } else { %>
                    Preencher Metas
                  <% } %>
                </button>
              </form>
            </div>
          </div>
        <% }) %>
      </div>
    </div>
  </div>
</section>