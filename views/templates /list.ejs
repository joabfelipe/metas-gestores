<section class="space-y-6">

  <div class="card">
    <div class="card-header">
      <div>
        <h2 class="text-xl font-semibold">Modelos de meta</h2>
        <p class="text-sm text-muted">Defina uma meta uma vez e aplique a múltiplos gestores e meses.</p>
      </div>
      <a href="/admin/templates/new" class="btn btn-primary btn-sm">+ Novo modelo</a>
    </div>
    <div class="card-body" style="padding:0;">
      <% if (!templates || templates.length === 0) { %>
        <div class="empty-state">
          <div class="text-4xl">🎯</div>
          <div class="text-sm font-semibold">Nenhum modelo cadastrado</div>
          <div class="text-sm text-muted">Crie um modelo para gerar metas mensais automaticamente.</div>
          <a href="/admin/templates/new" class="btn btn-primary btn-sm" style="margin-top:8px;">Criar primeiro modelo</a>
        </div>
      <% } else { %>
        <div class="table-wrap">
          <table class="table" style="min-width:100%;">
            <thead>
              <tr>
                <th>Título</th>
                <th>Departamento</th>
                <th style="text-align:center;">Alvo</th>
                <th>Vigência</th>
                <th style="text-align:center;">Aplicado a</th>
                <th>Ações</th>
              </tr>
            </thead>
            <tbody>
              <% templates.forEach(t => { %>
                <%
                  const formatPeriod = (p) => {
                    if (!p) return '—';
                    const [y, m] = p.split('-');
                    const names = ['Jan','Fev','Mar','Abr','Mai','Jun','Jul','Ago','Set','Out','Nov','Dez'];
                    return `${names[Number(m)-1]}/${y}`;
                  };
                  const assignmentCount = (t.assignments || []).length;
                %>
                <tr>
                  <td>
                    <div style="font-weight:500;"><%= t.title %></div>
                    <% if (!t.active) { %>
                      <span class="badge badge-muted" style="margin-top:2px;">Inativo</span>
                    <% } %>
                  </td>
                  <td style="color:var(--text-muted); font-size:12px;"><%= t.department || '—' %></td>
                  <td style="text-align:center; font-family:'DM Mono',monospace;"><%= t.targetValue %> <%= t.unit %></td>
                  <td style="font-size:12px; color:var(--text-muted);">
                    <%= formatPeriod(t.validFrom) %>
                    <% if (t.validUntil) { %>
                      &rarr; <%= formatPeriod(t.validUntil) %>
                    <% } else { %>
                      &rarr; <span style="color:var(--text-sub);">aberto</span>
                    <% } %>
                  </td>
                  <td style="text-align:center;">
                    <span class="badge badge-default"><%= assignmentCount %> gestor<%= assignmentCount !== 1 ? 'es' : '' %></span>
                  </td>
                  <td>
                    <div style="display:flex; gap:6px;">
                      <a href="/admin/templates/<%= t._id %>/edit" class="btn btn-secondary btn-xs">Editar</a>
                      <form action="/admin/templates/<%= t._id %>/delete" method="post" onsubmit="return confirm('Remover este modelo? As metas mensais ainda não preenchidas serão excluídas. As já preenchidas serão preservadas como histórico.');" style="display:inline;">
                        <button type="submit" class="btn btn-danger btn-xs">Remover</button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>

</section>
