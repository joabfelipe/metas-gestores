<%
  const isEdit = !!template;
  const action = isEdit ? `/admin/templates/${template._id}/update` : '/admin/templates';
  const sel = locals.selectedSet || new Set();
  const t = template || {};

  // Agrupar slots por gestor para exibição mais limpa
  const grouped = {};
  slots.forEach(s => {
    if (!grouped[s.managerId]) {
      grouped[s.managerId] = { name: s.managerName, items: [], departments: s.departments };
    }
    grouped[s.managerId].items.push(s);
  });
%>

<section class="space-y-6">
  <form method="post" action="<%= action %>" class="space-y-6">

    <div class="card">
      <div class="card-header">
        <div>
          <h2 class="text-xl font-semibold"><%= isEdit ? 'Editar modelo' : 'Novo modelo de meta' %></h2>
          <p class="text-sm text-muted">
            <% if (isEdit) { %>
              Alterações serão aplicadas às metas mensais ainda não preenchidas. Histórico é preservado.
            <% } else { %>
              O modelo gera automaticamente uma meta para cada mês × gestor selecionado.
            <% } %>
          </p>
        </div>
      </div>
      <div class="card-body">

        <div style="display:grid; grid-template-columns:1fr; gap:16px;">

          <div class="field">
            <label class="field-label">Título da meta</label>
            <input type="text" name="title" class="input" required value="<%= t.title || '' %>" placeholder="Ex: Crescer NPS" />
          </div>

          <div style="display:grid; grid-template-columns:1fr 1fr 1fr; gap:14px;">
            <div class="field">
              <label class="field-label">Departamento</label>
              <input list="departments-list" name="department" class="input" value="<%= t.department || '' %>" placeholder="Ex: Vendas" />
              <datalist id="departments-list">
                <% allDepartments.forEach(d => { %>
                  <option value="<%= d %>"></option>
                <% }) %>
              </datalist>
            </div>
            <div class="field">
              <label class="field-label">Valor alvo</label>
              <input type="number" step="0.01" name="targetValue" class="input" required value="<%= t.targetValue ?? '' %>" />
            </div>
            <div class="field">
              <label class="field-label">Unidade</label>
              <select name="unit" class="select">
                <% ['%','R$','un','pts'].forEach(u => { %>
                  <option value="<%= u %>" <%= (t.unit || '%') === u ? 'selected' : '' %>><%= u %></option>
                <% }) %>
              </select>
            </div>
          </div>

          <div style="display:grid; grid-template-columns:1fr 1fr; gap:14px;">
            <div class="field">
              <label class="field-label">Vigência início</label>
              <input type="month" name="validFrom" class="input" required value="<%= t.validFrom || '' %>" />
            </div>
            <div class="field">
              <label class="field-label">Vigência fim (opcional)</label>
              <input type="month" name="validUntil" class="input" value="<%= t.validUntil || '' %>" />
              <div style="font-size:11px; color:var(--text-sub); margin-top:4px;">Em branco = 12 meses a partir do início.</div>
            </div>
          </div>

        </div>
      </div>
    </div>

    <div class="card">
      <div class="card-header">
        <div>
          <h3 class="card-title">Aplicar a quais gestores e unidades</h3>
          <p class="text-sm text-muted">Selecione um ou mais. Cada combinação gera uma meta por mês de vigência.</p>
        </div>
        <div style="display:flex; gap:6px;">
          <button type="button" onclick="toggleAll(true)" class="btn btn-ghost btn-xs">Marcar todos</button>
          <button type="button" onclick="toggleAll(false)" class="btn btn-ghost btn-xs">Limpar</button>
        </div>
      </div>
      <div class="card-body">
        <% if (Object.keys(grouped).length === 0) { %>
          <div style="text-align:center; padding:24px; color:var(--text-muted); font-size:13px;">
            Nenhum gestor cadastrado. <a href="/admin/managers" style="color:var(--primary);">Cadastrar gestores</a>.
          </div>
        <% } else { %>
          <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(260px, 1fr)); gap:14px;">
            <% Object.keys(grouped).forEach(mgrId => { %>
              <% const g = grouped[mgrId]; %>
              <div style="border:1px solid var(--border); border-radius:8px; padding:14px;">
                <div style="font-weight:500; font-size:13px; margin-bottom:4px;"><%= g.name %></div>
                <% if (g.departments && g.departments.length) { %>
                  <div style="font-size:11px; color:var(--text-muted); margin-bottom:10px;"><%= g.departments.join(', ') %></div>
                <% } %>
                <% g.items.forEach(item => { %>
                  <% const value = `${item.managerId}|${item.businessUnit}`; %>
                  <% const checked = sel.has(value); %>
                  <label style="display:flex; align-items:center; gap:8px; padding:6px 0; cursor:pointer; font-size:13px;">
                    <input type="checkbox" name="assignments" value="<%= value %>" <%= checked ? 'checked' : '' %> style="width:16px; height:16px; cursor:pointer; accent-color:var(--primary);" />
                    <span>
                      <% if (item.businessUnit) { %>
                        Em <%= item.businessUnit %>
                      <% } else { %>
                        <span style="color:var(--text-muted);">Sem unidade</span>
                      <% } %>
                    </span>
                  </label>
                <% }) %>
              </div>
            <% }) %>
          </div>
        <% } %>
      </div>
    </div>

    <div style="display:flex; justify-content:flex-end; gap:8px;">
      <a href="/admin/templates" class="btn btn-secondary">Cancelar</a>
      <button type="submit" class="btn btn-primary"><%= isEdit ? 'Salvar alterações' : 'Criar modelo e gerar metas' %></button>
    </div>

  </form>
</section>

<script>
function toggleAll(state) {
  document.querySelectorAll('input[name="assignments"]').forEach(cb => cb.checked = state);
}
</script>
